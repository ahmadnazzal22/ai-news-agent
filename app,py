import json
import os
import schedule
import time
import threading
from flask import Flask, request, jsonify, render_template
from groq import Groq
from dotenv import load_dotenv
from scraper import AIScraperAgent

load_dotenv()

app = Flask(__name__)
client = Groq(api_key=os.getenv("GROQ_API_KEY"))
chat_history = []
file_lock = threading.Lock()

def load_news():
    with file_lock:
        try:
            with open("news_data.json", "r", encoding="utf-8") as f:
                return json.load(f)
        except:
            return []

def news_to_context():
    news = load_news()
    if not news:
        return "لا توجد أخبار متاحة حالياً."
    context = "الأخبار المتاحة:\n"
    for i, item in enumerate(news, 1):
        context += f"{i}. [{item['source']}] {item['title']}\n"
        context += f"   الترجمة: {item['translation']}\n"
        context += f"   التصنيف: {item['category']} | الأهمية: {item['importance']}\n\n"
    return context

def run_scheduler():
    schedule.every().day.at("08:00").do(
        lambda: AIScraperAgent().run(file_lock=file_lock)
    )
    while True:
        schedule.run_pending()
        time.sleep(60)

@app.route("/")
def index():
    return render_template("index.html")

@app.route("/chat", methods=["POST"])
def chat():
    global chat_history
    user_input = request.json.get("message", "")
    if not user_input.strip():
        return jsonify({"error": "Empty message"}), 400

    chat_history.append({"role": "user", "content": user_input})

    system_instruction = f"""أنت مساعد ذكي متخصص في أخبار التكنولوجيا.
أجب دائماً بنفس لغة المستخدم.
استخدم الأخبار التالية للإجابة:

{news_to_context()}"""

    try:
        response = client.chat.completions.create(
            model="llama-3.3-70b-versatile",
            messages=[{"role": "system", "content": system_instruction}] + chat_history
        )
        bot_reply = response.choices[0].message.content
        chat_history.append({"role": "assistant", "content": bot_reply})
        return jsonify({"reply": bot_reply})
    except Exception as e:
        chat_history.pop()
        return jsonify({"error": str(e)}), 500

@app.route("/clear", methods=["POST"])
def clear():
    global chat_history
    chat_history = []
    return jsonify({"status": "cleared"})

@app.route("/refresh-news", methods=["POST"])
def refresh_news():
    agent = AIScraperAgent()
    news = agent.run(file_lock=file_lock)
    return jsonify({"status": "done", "count": len(news)})

@app.route("/news", methods=["GET"])
def get_news():
    return jsonify(load_news())

if __name__ == "__main__":
    threading.Thread(target=run_scheduler, daemon=True).start()
    if not os.path.exists("news_data.json"):
        AIScraperAgent().run(file_lock=file_lock)
    app.run(debug=True)